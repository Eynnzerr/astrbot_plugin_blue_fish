{
  "api_url": {
    "type": "string",
    "description": "肥鱼工坊服务地址",
    "hint": "默认公共图片服务无需 API Key。自建服务可填写 http://127.0.0.1:8787 等可访问地址；不要附加 /api/v1。",
    "default": "https://eynnzerr.cloud/blue-fish"
  },
  "api_key": {
    "type": "string",
    "description": "接口密钥",
    "hint": "默认公共服务留空；使用自建服务或已获得单独调用凭证时填写。",
    "secret": true,
    "default": ""
  },
  "request_timeout": {
    "type": "int",
    "description": "接口超时（秒）",
    "default": 20
  },
  "default_sticker_id": {
    "type": "string",
    "description": "默认底图 ID",
    "hint": "未指定目录编号或 --id 时使用。填写服务素材列表中的完整 ID，如 studio-design-cheer。",
    "default": "studio-design-cheer"
  },
  "default_font": {
    "type": "string",
    "description": "默认字体",
    "options": ["maoken", "zcool-kuaile", "zcool-qingke-huangyou", "ma-shan-zheng"],
    "default": "maoken"
  },
  "default_color": {
    "type": "string",
    "description": "默认文字颜色",
    "hint": "使用 #RRGGBB 格式。",
    "default": "#3565ae"
  },
  "default_background": {
    "type": "string",
    "description": "默认画布背景",
    "options": ["transparent", "white"],
    "default": "transparent"
  },
  "default_layout": {
    "type": "string",
    "description": "默认布局",
    "hint": "caption 为留白配字，overlay 为叠加文字。",
    "options": ["caption", "overlay"],
    "default": "caption"
  }
}
